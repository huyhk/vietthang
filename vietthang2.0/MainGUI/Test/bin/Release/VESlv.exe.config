<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<appSettings>
  <add key="Provider" value="System.Data.SqlClient" />
  <add key="TimeOut" value="50" />
  <add key="LogFolder" value="log" />
  <add key="LogFileName" value="VNSACC.log" />
  <add key="LanguageFolder" value="xml" />
  <add key="DateFormat" value="dd/MM/yyyy" />
  <add key="EnabledColor" value="White" />
  <add key="ReadOnlyColor" value="LightGray" />
  <add key="DisabledColor" value="LightGray" />
  <add key="ComPort" value="COM1" />
  <add key="BaudRate" value="1200" />
  <add key="DataBit" value="8" />
  <add key="StopBit" value="One" />
  <add key="Parity" value="0" />
  <add key="HandShake" value="XOnXOff" />
  <add key="Min" value="0.1" />
  <add key="EndOfLine" value="00000" />
  <add key="DataPattern" value="\d+KGM" />
  <add key="Server" value="server" />
  <add key="Database" value="VES11" />
  <add key="UserName" value="sa" />
  <add key="Password" value="+wTNdXY//2k=" />
 </appSettings>
 <system.web>
  <trust level="Full" />
  <webControls clientScriptsLocation="/aspnet_client/{0}/{1}/" />
 </system.web>
</configuration>